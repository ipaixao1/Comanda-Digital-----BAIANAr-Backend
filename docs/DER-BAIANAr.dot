digraph DER {
graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, fontname="Helvetica", labelloc=t, fontsize=26, label="DER — Comanda Digital BAIANAr (MySQL, migrations V1–V5)\nAzul: usuários · Amarelo: cardápio e ficha técnica · Verde: estoque · Vermelho: fornecedores e compras · Roxo: pedidos\n "];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=tee, dir=both, arrowsize=0.8];
usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>usuario</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD><B>UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="senha_hash">senha_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="perfil">perfil</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="telefone">telefone</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="endereco">endereco</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fde68a"><B>categoria</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="descricao">descricao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="ordem">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
prato [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fde68a"><B>prato</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_id">categoria_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="descricao">descricao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(500)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="foto_url">foto_url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(500)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="preco_venda">preco_venda</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="tempo_preparo_min">tempo_preparo_min</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
ingrediente [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#bbf7d0"><B>ingrediente</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="sku">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD><TD><B>UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unidade_padrao">unidade_padrao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="estoque_minimo">estoque_minimo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,3)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="custo_unitario">custo_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,4)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
ficha_tecnica [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fde68a"><B>ficha_tecnica</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="prato_id">prato_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK,UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rendimento">rendimento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="modo_preparo">modo_preparo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
ficha_tecnica_item [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fde68a"><B>ficha_tecnica_item</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ficha_tecnica_id">ficha_tecnica_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ingrediente_id">ingrediente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,3)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="unidade">unidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="fator_correcao">fator_correcao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(5,2)</FONT></TD><TD> </TD></TR></TABLE>>];
fornecedor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fecaca"><B>fornecedor</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="razao_social">razao_social</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(200)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="cnpj">cnpj</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(18)</FONT></TD><TD><B>UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="telefone">telefone</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="categorias">categorias</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(200)</FONT></TD><TD> </TD></TR></TABLE>>];
fornecedor_produto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fecaca"><B>fornecedor_produto</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fornecedor_id">fornecedor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK,UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ingrediente_id">ingrediente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK,UK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="preco">preco</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,4)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="unidade_venda">unidade_venda</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD><TD> </TD></TR></TABLE>>];
pedido_compra [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fecaca"><B>pedido_compra</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fornecedor_id">fornecedor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="valor_total">valor_total</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
pedido_compra_item [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fecaca"><B>pedido_compra_item</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="pedido_compra_id">pedido_compra_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ingrediente_id">ingrediente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,3)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="preco_unitario">preco_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,4)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="subtotal">subtotal</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,2)</FONT></TD><TD> </TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e9d5ff"><B>pedido</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cliente_id">cliente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="valor_total">valor_total</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="endereco_entrega">endereco_entrega</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="observacoes">observacoes</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(500)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_cancelamento">motivo_cancelamento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
pedido_item [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e9d5ff"><B>pedido_item</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="pedido_id">pedido_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="prato_id">prato_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="preco_unitario">preco_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="observacoes">observacoes</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD><TD> </TD></TR></TABLE>>];
estoque_movimentacao [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#bbf7d0"><B>estoque_movimentacao</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ingrediente_id">ingrediente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,3)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="lote">lote</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="validade">validade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="custo_unitario">custo_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,4)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="pedido_compra_id">pedido_compra_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="pedido_id">pedido_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
endereco_cliente [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>endereco_cliente</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cliente_id">cliente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD><TD><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="cep">cep</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(9)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="rua">rua</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="numero">numero</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="complemento">complemento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="bairro">bairro</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="cidade">cidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="padrao">padrao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD> </TD></TR></TABLE>>];
categoria -> prato [label="categoria_id", arrowtail=tee, arrowhead=crow];
prato -> ficha_tecnica [label="prato_id", arrowtail=tee, arrowhead=tee];
ficha_tecnica -> ficha_tecnica_item [label="ficha_tecnica_id", arrowtail=tee, arrowhead=crow];
ingrediente -> ficha_tecnica_item [label="ingrediente_id", arrowtail=tee, arrowhead=crow];
fornecedor -> fornecedor_produto [label="fornecedor_id", arrowtail=tee, arrowhead=crow];
ingrediente -> fornecedor_produto [label="ingrediente_id", arrowtail=tee, arrowhead=crow];
fornecedor -> pedido_compra [label="fornecedor_id", arrowtail=tee, arrowhead=crow];
usuario -> pedido_compra [label="usuario_id", arrowtail=tee, arrowhead=crow];
pedido_compra -> pedido_compra_item [label="pedido_compra_id", arrowtail=tee, arrowhead=crow];
ingrediente -> pedido_compra_item [label="ingrediente_id", arrowtail=tee, arrowhead=crow];
usuario -> pedido [label="cliente_id", arrowtail=tee, arrowhead=crow];
pedido -> pedido_item [label="pedido_id", arrowtail=tee, arrowhead=crow];
prato -> pedido_item [label="prato_id", arrowtail=tee, arrowhead=crow];
ingrediente -> estoque_movimentacao [label="ingrediente_id", arrowtail=tee, arrowhead=crow];
pedido_compra -> estoque_movimentacao [label="pedido_compra_id", arrowtail=tee, arrowhead=crow];
pedido -> estoque_movimentacao [label="pedido_id", arrowtail=tee, arrowhead=crow];
usuario -> estoque_movimentacao [label="usuario_id", arrowtail=tee, arrowhead=crow];
usuario -> endereco_cliente [label="cliente_id", arrowtail=tee, arrowhead=crow];
}